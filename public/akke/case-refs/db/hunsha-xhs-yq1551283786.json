  ],
  [
   "氛围感成片稳定出单",
   "意向最多的 4 条都是氛围感成片，分别有 15、10、9、9 条，合计 43 条，所以不是哪一条碰巧火了，这种拍法本身就招客。「权威合照」40 条评论里只有 4 条想买，说明画面不同，带客效果差很多。"
  ]
 ],
