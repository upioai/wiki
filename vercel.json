{
  "outputDirectory": "public",
  "buildCommand": "node scripts/build-characters.js && node scripts/build-akke-map.js && node scripts/build-learn.js && node scripts/build-timeline.js && node scripts/build-index.js",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/team/:path*",
      "destination": "https://wecom-chat.vercel.app/team/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://wecom-chat.vercel.app/_next/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|css|js|mjs|map)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/team/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
