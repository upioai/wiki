{
  "outputDirectory": "public",
  "ignoreCommand": "sh scripts/vercel-ignore.sh",
  "buildCommand": "node scripts/build-characters.js && node scripts/build-akke-map.js && node scripts/build-learn.js && node scripts/build-timeline.js && node scripts/build-index.js",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|css|js|mjs|map)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/akke/case-refs/:slug((?!account$|index$|assets$|db$)(?!.*--td-)[^/.]+)", "destination": "/akke/case-refs/account?s=:slug", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/case-refs/labels", "destination": "https://akke-case-refs-labels.vercel.app/api/labels" }
  ]
}
